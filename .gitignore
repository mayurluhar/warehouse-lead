# Dependencies
node_modules/
.pnp
.pnp.js

# SST build & state cache
.sst/

# Build outputs
dist/
build/
*.tsbuildinfo

# Compiler output must never live beside TypeScript sources.
# Every package is noEmit (see tsconfig.base.json); these rules are a backstop
# in case someone runs tsc with emit enabled.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
functions/src/**/*.js
functions/src/**/*.d.ts

# Generated by `sst dev` / `sst deploy` — regenerated on every run
sst-env.d.ts

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Files
.DS_Store
Thumbs.db
