# ==============================================================================
# Warehouse Lead Intelligence Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Credentials & Region (Required for AWS Bedrock & SST Deployment)
# ------------------------------------------------------------------------------
# The AWS region where your Bedrock model access is enabled (e.g., us-east-1, us-west-2, ap-south-1)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# AWS Access Credentials (if not using ~/.aws/credentials or AWS SSO profiles)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Optional: AWS Session Token (if using temporary STS credentials or AWS SSO)
# AWS_SESSION_TOKEN=

# Optional: AWS CLI Profile Name (if you configured named profiles in ~/.aws/credentials)
# AWS_PROFILE=default

# ------------------------------------------------------------------------------
# 2. AWS Bedrock AI Configuration
# ------------------------------------------------------------------------------
# Region where Bedrock foundation models are enabled
BEDROCK_REGION=us-east-1

# Model ID for structured lead extraction.
#
# IMPORTANT: most current Anthropic models on Bedrock cannot be invoked by bare
# foundation-model ID. Bedrock rejects those with:
#   "Invocation of model ID <id> with on-demand throughput isn't supported.
#    Retry your request with the ID or ARN of an inference profile."
#
# The fix is a cross-region inference profile ID — the foundation ID prefixed
# with your geography:
#   us-*  regions ->  us.anthropic.<model>
#   eu-*  regions ->  eu.anthropic.<model>
#   ap-*  regions ->  apac.anthropic.<model>     (ap-south-1 / Mumbai)
#
# You can leave the bare ID below: BedrockLeadExtractor detects that error and
# retries once with the correct regional prefix, caching whichever works. Setting
# the profile ID explicitly just skips that one probe per process.
#
# List what is actually enabled in YOUR account before choosing:
#   aws bedrock list-inference-profiles --region ap-south-1 \
#     --query "inferenceProfileSummaries[].inferenceProfileId"
#   aws bedrock list-foundation-models --region ap-south-1 \
#     --query "modelSummaries[?providerName=='Anthropic'].modelId"
#
# Model access must also be granted in the Bedrock console
# (Console -> Bedrock -> Model access) or calls fail with AccessDeniedException.
# Must be one of the IDs in packages/core/.../entities/ExtractionModel.ts — the
# UI renders its selector from that list and the server validates against it.
DEFAULT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ------------------------------------------------------------------------------
# 3. Document sources (live RSS)
# ------------------------------------------------------------------------------
# OPTIONAL. The feed list lives in code, at
#   packages/core/src/infrastructure/connectors/publicationFeeds.ts
# so a fresh clone scans with no setup. Add or remove publications there.
#
# Setting this variable REPLACES that list entirely — use it to run a different
# set of sources in a deployment without a rebuild. One feed per line (or
# semicolon-separated), "name | url | trust tier". Trust tier is optional and
# defaults to reputable_media; valid values are official, reputable_media,
# aggregator, unverified. Lines starting with # are ignored, as are malformed
# entries (logged and skipped, never fatal).
#
# Only feed ADDRESSES are ever hardcoded — every article, headline and date is
# fetched live at scan time.
# PUBLICATION_FEEDS="Logistics Insider | https://www.logisticsinsider.in/feed/ | reputable_media
# Cargo Talk | https://www.cargotalk.in/feed | reputable_media"

# Items read per feed. 0 (the default) means every item the feed publishes.
# Note this cannot reach beyond what RSS itself serves — a rolling window of the
# latest 20-50 items, not an archive. Set a number only to deliberately truncate.
RSS_MAX_ITEMS_PER_FEED=0

# Wall-clock ceiling for one publication pass. Feeds are read one at a time, so
# raise this if you add many feeds; any not reached are reported as skipped.
RSS_TIME_BUDGET_MS=120000

# Google News search is opt-in. Off by default because its links are
# news.google.com redirects that often serve an anti-bot interstitial instead of
# the article, and query volume gets the caller rate-limited.
# ENABLE_GOOGLE_NEWS=true

# ------------------------------------------------------------------------------
# 4. Geocoding (live place lookup)
# ------------------------------------------------------------------------------
# Place names and coordinates are fetched live; none are stored in the codebase.
# Defaults to the public OpenStreetMap Nominatim service, which needs no API key.
#
# Nominatim's usage policy requires a User-Agent that identifies your
# application and allows at most 1 request/second. Set a real contact address
# below if you use the public instance for anything beyond local development.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=warehouse-lead-intelligence-poc/0.1 (contact: you@example.com)
NOMINATIM_MIN_INTERVAL_MS=1100

# Compass probes taken around the search radius when naming nearby places.
# Each is one paced request, so this trades scan latency for geographic reach.
NOMINATIM_PROBE_COUNT=4

# Restrict geocoding to one ISO country code, or leave unset to search worldwide.
NOMINATIM_COUNTRY_CODE=in

# ------------------------------------------------------------------------------
# 5. LinkedIn discovery (web search provider)
# ------------------------------------------------------------------------------
# LinkedIn publishes no API for searching posts, and its terms prohibit
# automated access to its own pages. The LinkedIn tab therefore reaches only
# publicly INDEXED LinkedIn pages, by asking a web search provider with a
# site: filter — the same content a search engine already shows anyone.
#
# Leave these unset and the LinkedIn tab is disabled in the UI rather than
# offering a scan that can only fail.
#
# Pick one provider and paste its key:
#   serper — https://serper.dev        (2,500 free queries, no card)
#   brave  — https://brave.com/search/api  (2,000 free queries/month)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Queries per LinkedIn scan. Each one costs a provider credit, so this is the
# knob that decides how fast a free tier is consumed. Places nearest your
# search centre are queried first, so a low cap loses the most distant places.
LINKEDIN_MAX_QUERIES=8
LINKEDIN_RESULTS_PER_QUERY=10

# ------------------------------------------------------------------------------
# 6. Local Development & API Settings
# ------------------------------------------------------------------------------
# Port for the local node API server (functions/src/local-server.ts)
PORT=4000

# Backend API URL for the Vite frontend (apps/web)
# For local dev: http://localhost:4000
# For SST cloud dev: your SST Lambda Function URL (e.g., https://xyz.lambda-url.us-east-1.on.aws)
VITE_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 7. SST Stage Configuration (Optional)
# ------------------------------------------------------------------------------
# SST_STAGE=dev
